{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:000000000000:secret:services/user-auth/database-*",
        "arn:aws:secretsmanager:us-east-1:000000000000:secret:services/user-auth/authentication-*"
      ]
    }
  ]
}